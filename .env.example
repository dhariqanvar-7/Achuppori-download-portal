# =============================================================================
# ACHUPPORI ENVIRONMENT TEMPLATE (Copy this to .env and fill in real values)
# =============================================================================

# 1. SENDER EMAIL: The bot/account that authenticates with Gmail and sends the email
SENDER_EMAIL=your-sender-system@gmail.com

# 2. SENDER APP PASSWORD: The 16-character App Password generated in Google Account
SENDER_PASSWORD=your-16-char-app-password

# 3. SUPPORT INBOX: Where incoming user queries arrive
SUPPORT_INBOX=your-support-email@gmail.com

# Server Port
PORT=3000
